{
  "minimums": { "gradle": "9.6", "kotlin": "2.4.0", "agp": "9.4.0" },
  "keys": [
    { "key": "android.compileSdk", "type": "int", "default": 37 },
    { "key": "android.minSdk", "type": "int", "default": 24 },
    { "key": "android.targetSdk", "type": "int", "default": 37 },
    { "key": "android.testInstrumentationRunner", "type": "string", "default": "androidx.test.runner.AndroidJUnitRunner" },
    { "key": "android.hostTests", "type": "boolean", "default": true },
    { "key": "jvm.target", "type": "int", "default": 21 },
    { "key": "kotlin.warningsAsErrors", "type": "boolean", "default": false },
    { "key": "kotlin.optIns", "type": "list", "default": [], "module": "append" },
    { "key": "kotlin.freeCompilerArgs", "type": "list", "default": [], "module": "append" },
    { "key": "kotlin.explicitApi", "type": "boolean", "default": false },
    { "key": "kotlin.testDependencies", "type": "boolean", "default": true },
    { "key": "kotlin.flatLayout", "type": "boolean", "default": false },
    { "key": "kotlin.jvmDefault", "type": "string" },
    { "key": "ios.architectures", "type": "list", "default": ["iosArm64", "iosSimulatorArm64"], "module": "replace" },
    { "key": "quality.config", "type": "list", "default": [], "module": "append" },
    { "key": "quality.source", "type": "list", "default": ["src"], "module": "replace" },
    { "key": "quality.buildUponDefaultConfig", "type": "boolean", "default": true },
    { "key": "quality.composeRules", "type": "boolean", "default": false },
    { "key": "mainContext.platforms", "type": "list", "default": ["android", "ios", "jvm"], "module": "replace" },
    { "key": "mainContext.testCompilations", "type": "boolean", "default": true },
    { "key": "mainContext.dependency", "type": "boolean", "default": true },
    { "key": "compose.metrics", "type": "boolean", "default": false },
    { "key": "compose.reports", "type": "boolean", "default": false },
    { "key": "compose.stabilityConfigurationFiles", "type": "list", "default": [], "module": "append" },
    { "key": "publish.artifactIdPrefix", "type": "string", "default": "", "buildWideOnly": true },
    { "key": "publish.description", "type": "string" },
    { "key": "publish.url", "type": "string" },
    { "key": "publish.license.name", "type": "string" },
    { "key": "publish.license.url", "type": "string" },
    { "key": "publish.developer.id", "type": "string" },
    { "key": "publish.developer.name", "type": "string" },
    { "key": "publish.developer.url", "type": "string" },
    { "key": "publish.scm.url", "type": "string" },
    { "key": "publish.scm.connection", "type": "string" },
    { "key": "publish.scm.developerConnection", "type": "string" },
    { "key": "publish.signing", "type": "boolean", "default": true },
    { "key": "publish.abi.enabled", "type": "boolean", "default": true, "buildWideOnly": true },
    { "key": "publish.abi.excludedNames", "type": "list", "default": [], "module": "append" },
    { "key": "publish.abi.excludedAnnotations", "type": "list", "default": [], "module": "append" },
    { "key": "application.applicationId", "type": "string" },
    { "key": "application.versionCode", "type": "int" },
    { "key": "application.versionName", "type": "string" },
    { "key": "application.minify", "type": "boolean", "default": true },
    { "key": "application.proguardFiles", "type": "list", "default": ["proguard-rules.pro"], "module": "append" },
    { "key": "application.desugaring", "type": "boolean", "default": true },
    { "key": "library.desugaring", "type": "boolean", "default": true },
    { "key": "library.consumerProguardFiles", "type": "list", "default": ["consumer-rules.pro"], "module": "append" },
    { "key": "library.resourcePrefix", "type": "boolean", "default": true },
    { "key": "library.resourcePrefixDroppedSegments", "type": "list", "default": [], "module": "append" },
    { "key": "library.skipEmptyAndroidTest", "type": "boolean", "default": true }
  ]
}
